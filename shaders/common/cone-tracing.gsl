#ifndef CONE_TRACING_GSL
#define CONE_TRACING_GSL

#define DIFFUSE_CONE_COUNT 6

const float diffuseConeWeights[DIFFUSE_CONE_COUNT] = float[DIFFUSE_CONE_COUNT](
	0.25f, 0.15f, 0.15f, 0.15f, 0.15f, 0.15f);

const half3 diffuseConeDirs[DIFFUSE_CONE_COUNT] = half3[DIFFUSE_CONE_COUNT]
( 
	half3( 0.0hf,       0.0hf,      1.0hf),
	half3( 0.0hf,       0.866025hf, 0.5hf),
	half3( 0.823639hf,  0.267617hf, 0.5hf),
	half3( 0.509037hf, -0.700629hf, 0.5hf),
	half3(-0.509037hf, -0.700629hf, 0.5hf),
	half3(-0.823639hf,  0.267617hf, 0.5hf)
);

float roughnessToAperture(float roughness) // Polynomial approximation of the specular GGX
{
	// https://rootserver.rosseaux.net/demoscene/prods/HowToUseVoxelConeTracingWithTwoBouncesForEverythingInsteadOfJustGlobalIllumination.pdf
	return tan(0.0003474660443456835f + (roughness * (1.3331290497744692f - (roughness * 0.5040552688878546f))));
}

#endif // CONE_TRACING_GSL